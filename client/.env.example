# ===================== CLIENT ENV (Vercel) =====================
# Copy file này thành `.env` khi chạy local.

# Base URL của Vite dev server (dùng cho browser redirect/display)
VITE_BASE_URL=http://localhost:5173

# URL server backend — build-time trên Vercel, set trong dashboard:
#   https://<server>.onrender.com
VITE_SERVER_BASE_URL=http://localhost:8000

# --- Sentry (OPTIONAL — bỏ trống để không bật) ---
# Vào https://sentry.io → tạo project React → copy DSN.
VITE_SENTRY_DSN=
