# ===================== SERVER ENV (Render) =====================
# Copy file này thành `.env` khi chạy local, hoặc set trên Render dashboard.

# --- Server ---
PORT=8000

# --- Database (MongoDB Atlas) ---
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# --- CORS (comma-separated, không có space) ---
# Prod: https://<client>.vercel.app
# Dev: http://localhost:5173 (mặc định nếu thiếu)
# App luôn cho phép thêm các origin local sau (dành cho test điện thoại/ngrok):
#   http://localhost:5173, http://192.168.1.93:5173, https://*.ngrok-free.app
ALLOWED_ORIGINS=http://localhost:5173

# --- JWT ---
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES_IN=30m
JWT_COOKIE_EXPIRES_IN=7

# --- Cloudinary (upload ảnh món ăn) ---
CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>
CLOUDINARY_NAME=<cloud_name>
CLOUDINARY_API_KEY=<key>
CLOUDINARY_API_SECRET=<secret>

# --- VNPay ---
VNP_HASHSECRET_KEY=change-me
VNP_TMNCODE=change-me
VNP_URL=https://sandbox.vnpay.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:8000/api/payments/vnpay-return

# --- Sentry (OPTIONAL — bỏ trống để không bật) ---
# Vào https://sentry.io → tạo project Node.js → copy DSN.
SENTRY_DSN=

# --- Redis Cache (OPTIONAL — mặc định TẮT để chạy thuần Database) ---
# ENABLE_REDIS=true để bật cache menu. Nếu Redis down/lỗi → app TỰ fallback về
# query Database (không crash), retry tối đa 3 lần + tự hồi phục nền 30s.
#
# --- BullMQ Message Queue (dùng CHUNG ENABLE_REDIS / REDIS_URL — KHÔNG cần env mới) ---
# Với ENABLE_REDIS=true: server khởi động worker xử lý 3 queue nền:
#   payment-webhook (complete-payment) · notification (create-notification) ·
#   order-fanout (new-order — socket + notification + orderCount).
# Với ENABLE_REDIS=false (mặc định): KHÔNG bật worker; producer tự chạy FALLBACK
# INLINE cùng handler (graceful degradation) — nghiệp vụ vẫn đủ, chỉ chậm hơn đôi chút.
ENABLE_REDIS=false
REDIS_URL=redis://localhost:6379
